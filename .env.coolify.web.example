# One cost center/domain, compose.coolify.web.yaml. Duplicate the Coolify resource
# for another event. Change EVENT_SLUG, event settings, hostname and HTTPS origin.
# The backend must already be deployed on this same Docker host.
DEPLOYMENT_ENV=production
SHARED_NETWORK=pt-reimbursement-shared
PRIVATE_DATA_VOLUME=pt-reimbursement-private
DJANGO_SECRET_KEY=REPLACE_WITH_SAME_SECRET_AS_SHARED_BACKEND
# Use the same complete internal URL from the separate Coolify database.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_COOLIFY_DATABASE_HOST:5432/REPLACE_WITH_DATABASE_NAME
HEALTHCHECK_TOKEN=REPLACE_WITH_HEALTH_CHECK_TOKEN
ALLOWED_HOSTS=workshop-a.example.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://workshop-a.example.org
TRUSTED_PROXY_CIDRS=REPLACE_WITH_ACTUAL_PROXY_NETWORK_CIDRS
CLAMAV_HOST=pt-reimbursement-scanner
APPROVED_DELIVERY_RECIPIENTS=finance@example.org
TEST_RECIPIENT_ALLOWLIST=

EVENT_SLUG=workshop-a
EVENT_NAME=ProjectTogether Workshop A
EVENT_COST_CENTER=REPLACE_WITH_APPROVED_KST
EVENT_COST_OBJECT=REPLACE_WITH_APPROVED_KTR
EVENT_RECIPIENT=finance@example.org
EVENT_SUPPORT_EMAIL=finance@example.org
# Use Coolify's multiline value editor for a privacy notice spanning several lines.
EVENT_PRIVACY_NOTICE=REPLACE_WITH_APPROVED_PRIVACY_NOTICE
EVENT_PRIVACY_VERSION=REPLACE_WITH_APPROVED_VERSION
EVENT_FINANCE_NOTE=
EVENT_INSTRUCTIONS=Bitte reiche alle Auslagen mit den zugehörigen Belegen ein.
EVENT_ALLOWED_CURRENCIES=EUR
EVENT_TRAVEL_REQUIRED=1
# Set to 1 after completing the approved configuration and delivery test.
EVENT_ACTIVE=0
# Optional ISO dates and timestamps. Timestamps require an explicit timezone.
EVENT_TRIP_START=
EVENT_TRIP_END=
EVENT_OPENS_AT=
EVENT_CLOSES_AT=

# Keep these settings consistent with the shared backend and other web resources.
# Two Gunicorn workers per web resource. Set to 2 * number of web resources.
TOTAL_WEB_WORKERS=4
MAX_ACTIVE_DRAFTS=1000
MAX_DRAFTS_PER_NETWORK=300
MAX_UPLOADS_PER_NETWORK=60000
MAX_UPLOADS_PER_NETWORK_PER_MINUTE=3000
MAX_UPLOAD_BYTES_PER_NETWORK=45000000000
MAX_PENDING_VALIDATIONS=1000
MAX_JOB_AGE_SECONDS=900
MAX_FINAL_PDF_BYTES=10000000
MIN_FREE_STORAGE_BYTES=1000000000
JOB_TIMEOUT_SECONDS=240
